{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detent",
  "account_id": "e899bae6a5bc4e8bdb660ca2496cd339",
  "workers_dev": true,
  "observability": { "enabled": true },
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/opengraph-image",
      "!/*/opengraph-image"
    ]
  }
}
