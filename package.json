{
  "name": "detent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-pro.mjs && node scripts/build-site-data.mjs && node scripts/build-pro-registry.mjs",
    "prebuild:vinext": "npm run prebuild",
    "predev": "node scripts/build-site-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "postbuild:vinext": "node scripts/build-og.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "deploy:secrets": "node scripts/deploy.mjs --secrets"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@better-auth/infra": "^0.4.26",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@paper-design/shaders-react": "^0.0.82",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@vinext/cloudflare": "^1.3.0",
    "ai": "^7.0.153",
    "better-auth": "^1.7.15",
    "geist": "^1.9.2",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "posthog-js": "^1.447.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "16.35.0",
    "vinext": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "type": "module",
  "overrides": {
    "@libsql/kysely-libsql": {
      "@libsql/client": "$@libsql/client"
    }
  }
}
